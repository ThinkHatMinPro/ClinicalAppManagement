generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  STAFF
  DOCTOR
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient      Patient?
  doctor       Doctor?
}

model Patient {
  id          String   @id @default(cuid())
  userId      String?  @unique
  name        String
  dateOfBirth DateTime?
  gender      String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointments Appointment[]

  @@index([name])
  @@index([phone])
  @@index([email])
}

model Doctor {
  id          String   @id @default(cuid())
  userId      String?  @unique
  name        String
  specialty   String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointments Appointment[]

  @@index([name])
  @@index([specialty])
}

model Appointment {
  id        String            @id @default(cuid())
  patientId String
  doctorId  String
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(SCHEDULED)
  reason    String?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([doctorId, startTime, endTime])
  @@index([patientId, startTime])
  @@index([startTime])
  @@index([status])
}